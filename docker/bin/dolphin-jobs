#!/bin/bash
# The scheduled jobs (PHASE-2.md §13): fetch the 理财 index's daily closes, catch up and clean up 文件传输 once the
# database is ready, so a restart makes up the days the server was down, then every day after 00:05 (the container's TZ,
# Asia/Shanghai). A job that fails is tried again the next day, at a restart, or with `dolphin jobs run`. After the
# A-share close, from 15:30, the day's close is fetched; a fetch that fails is tried again every 10 minutes six times,
# then every hour to the end of the day, and once more at 00:05 before the jobs. A day fetched late is applied by the
# next run_daily.
set -uo pipefail
until dolphin jobs >/dev/null 2>&1; do sleep 10; done
last=
fetched=
tries=0
next_fetch=0
while true; do
  today=$(date +%F)
  if [ "$today" != "$last" ] && { [ -z "$last" ] || (( 10#$(date +%H%M) >= 5 )); }; then
    dolphin jobs fetch || true
    dolphin jobs run || echo "dolphin-jobs: a job failed; see dolphin jobs" >&2
    dolphin jobs clean >/dev/null || echo "dolphin-jobs: the 文件传输 clean-up failed" >&2
    last=$today
    tries=0
    next_fetch=0
  elif [ "$fetched" != "$today" ] && (( 10#$(date +%H%M) >= 1530 )) && (( $(date +%s) >= next_fetch )); then
    if dolphin jobs fetch; then
      fetched=$today
    else
      tries=$(( tries + 1 ))
      next_fetch=$(( $(date +%s) + (tries < 6 ? 600 : 3600) ))
    fi
  fi
  sleep 60
done
