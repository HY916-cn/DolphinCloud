#!/bin/bash
# Run `dolphin backup` and then `dolphin check` every day at BACKUP_TIME (HH:MM, container time zone).
set -euo pipefail
while true; do
  now=$(date +%s)
  next=$(date -d "today $BACKUP_TIME" +%s)
  [ "$next" -gt "$now" ] || next=$(date -d "tomorrow $BACKUP_TIME" +%s)
  sleep $((next - now))
  dolphin backup || echo "dolphin-backup-schedule: backup failed" >&2
  dolphin check || echo "dolphin-backup-schedule: ledger mismatch, logged to audit_log" >&2
done
