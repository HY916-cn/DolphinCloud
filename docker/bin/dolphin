#!/bin/bash
# Operations CLI: dolphin create-admin <login> | reset-admin | backup | backups | restore <file> | check | jobs [run|fetch] | status | health
# With BACKUP_RECIPIENT (an age public key) backups are encrypted to it (.tar.gz.age); restoring one reads the
# matching private key from stdin: docker exec -i dolphincloud dolphin restore <file> < backup-key.txt
set -euo pipefail
BACKUPS=/data/backups
psql_() { psql -h /var/run/postgresql -U postgres -d postgres -v ON_ERROR_STOP=1 "$@"; }

# audit <action> <file>: one audit_log row; skipped while the database predates app_private.log_system
# (the backup before an upgrade migrates, or restoring an old backup).
audit() {
  psql_ -qAt -v action="$1" -v file="$2" >/dev/null <<'SQL'
select to_regprocedure('app_private.log_system(text,jsonb)') is not null as has_log \gset
\if :has_log
select app_private.log_system(:'action', jsonb_build_object('file', :'file'));
\endif
SQL
}

backup() {
  local name tmp
  umask 077
  name="dolphin-$(date +%Y%m%d-%H%M%S).tar.gz${BACKUP_RECIPIENT:+.age}"
  tmp=$(mktemp -d)
  pg_dump -h /var/run/postgresql -U postgres -d postgres -Fc -f "$tmp/db.dump"
  if [ -n "${BACKUP_RECIPIENT:-}" ]; then
    tar -cz -C "$tmp" db.dump -C /data storage | age -r "$BACKUP_RECIPIENT" -o "$BACKUPS/$name.part"
  else
    echo "BACKUP_RECIPIENT is not set: $name is not encrypted" >&2
    tar -czf "$BACKUPS/$name.part" -C "$tmp" db.dump -C /data storage
  fi
  mv "$BACKUPS/$name.part" "$BACKUPS/$name"
  rm -rf "$tmp"
  find "$BACKUPS" -name 'dolphin-*.tar.gz*' ! -name '*.part' -mtime +"$BACKUP_RETENTION_DAYS" -delete
  audit backup.create "$name"
  echo "$BACKUPS/$name"
}

restore() {
  local file="$BACKUPS/$(basename "${1:?usage: dolphin restore <file>}")" tmp
  [ -f "$file" ] || { echo "No such backup: $file" >&2; exit 1; }
  tmp=$(mktemp -d)
  case "$file" in
    *.age) age -d -i - "$file" | tar -xz -C "$tmp" ;;
    *) tar -xzf "$file" -C "$tmp" ;;
  esac
  [ -f "$tmp/db.dump" ] || { echo "Not a dolphin backup: $file" >&2; exit 1; }
  echo "Backing up current data first: $(backup)"
  supervisorctl stop caddy auth rest storage backup-schedule >/dev/null
  # dolphin-jobs is not in images before M7, where a rollback runs this script. Started again, it catches up at once.
  supervisorctl stop dolphin-jobs >/dev/null 2>&1 || true
  trap 'supervisorctl start auth rest storage caddy backup-schedule >/dev/null; supervisorctl start dolphin-jobs >/dev/null 2>&1 || true' EXIT
  # The backup goes into a new database that then replaces postgres, so whatever came after the backup (a later version's
  # tables, functions, foreign keys to the backed-up tables, default privileges) neither blocks the restore nor stays
  # behind. A backup that does not restore leaves postgres as it was; a database left by such a run is dropped next time.
  PGOPTIONS='-c client_min_messages=warning' psql_ -qc 'drop database if exists dolphin_restore' \
    -c 'create database dolphin_restore template template0'
  pg_restore -h /var/run/postgresql -U postgres -d dolphin_restore --single-transaction --exit-on-error "$tmp/db.dump"
  psql -h /var/run/postgresql -U postgres -d template1 -v ON_ERROR_STOP=1 -qc 'drop database postgres with (force)' \
    -c 'alter database dolphin_restore rename to postgres'
  # /data/storage may be a mount point of its own: replace its contents, not the directory.
  find /data/storage -mindepth 1 -delete
  cp -a "$tmp/storage/." /data/storage/
  chown -R dolphin: /data/storage
  rm -rf "$tmp"
  psql_ -qc "notify pgrst, 'reload schema'"
  audit backup.restore "$(basename "$file")"
  echo "Restored $file"
}

# On the first start dolphin-migrate takes a minute; a call made meanwhile would run against a half-built schema.
ready() {
  local want=$(ls /opt/dolphin/migrations/*.sql | wc -l)
  for _ in $(seq 1 90); do
    [ "$(psql_ -qAt -c 'select count(*) from public.app_migrations' 2>/dev/null)" = "$want" ] && return
    sleep 2
  done
  echo "The database is still being set up; try again in a minute." >&2
  exit 1
}

create_admin() {
  local login="${1:?usage: dolphin create-admin <login>}"
  ready
  psql_ -qAt -v login="$login" <<'SQL'
select 'Created ' || (r ->> 'login_id') || ' (bank admin). Initial password: ' || (r ->> 'password')
  || E'\nSign in with it and set a new one.'
from app_private.create_admin(:'login') r;
SQL
}

# The 银行管理员 forgot its password: a new random one, to be changed at the next sign-in.
reset_admin() {
  ready
  psql_ -qAt <<'SQL'
select 'Reset ' || (r ->> 'login_id') || ' (bank admin). New password: ' || (r ->> 'password')
  || E'\nSign in with it and set a new one.'
from app_private.reset_admin() r;
SQL
}

# Lists ledger mismatches (and logs them to audit_log); exits 1 when there are any.
check() {
  local rows
  rows=$(psql_ -qAt -F ' ' -c "select kind, key, 'recorded', recorded, 'expected', expected from app_private.check_balances()")
  if [ -n "$rows" ]; then echo "$rows"; exit 1; fi
  echo "Balances and stock match the ledger"
  [ -n "${BACKUP_RECIPIENT:-}" ] || echo "Warning: BACKUP_RECIPIENT is not set, so backups are not encrypted" >&2
}

# The scheduled jobs (PHASE-2.md §13): how far each has got, its last success and its last failure, and the current term.
jobs_show() {
  ready
  psql_ -qAt <<'SQL'
select format('%-6s done to %s, last ok %s%s', job, done_to,
  coalesce(to_char(last_ok at time zone 'Asia/Shanghai', 'YYYY-MM-DD HH24:MI'), 'never'), ', FAILED ' || last_err)
from public.job_runs order by job;
select case when t.id is null then 'term:  none' else format('term:  %s (%s to %s)', t.name, t.starts_on, t.ends_on) end
from (select (app_private.current_term(app_private.cn_date(now()))).*) t;
SQL
}

# Catches up to yesterday (and today's Monday) now; exits 1 when a job fails, which stops at that day.
jobs_run() {
  local out
  ready
  out=$(psql_ -qAt <<'SQL'
with r as materialized (select app_private.run_jobs() as j)
select line from (
  select i, format('%s %s %s', e ->> 'job', e ->> 'day', e ->> 'status') as line
  from r, jsonb_array_elements(j -> 'ran') with ordinality x(e, i)
  union all
  select 0, format('FAILED %s %s: %s', j -> 'failed' ->> 'job', j -> 'failed' ->> 'day', j -> 'failed' ->> 'error')
  from r where j -> 'failed' <> 'null'
) l order by i = 0, i;
SQL
)
  echo "${out:-Nothing to catch up}"
  ! grep -q '^FAILED' <<<"$out"
}

# 理财 (PHASE-2.md §10.10): the index's latest daily closes into wealth_days, the trading days that have none yet
# (today's after 15:30), from Tencent, else Sina, else eastmoney. When none answers with closes, says so, logs
# wealth.fetch_failed and exits 1, for dolphin-jobs to try again; a trading day still missing is entered by hand.
jobs_fetch() {
  local symbol secid src url body out errors=
  ready
  symbol=$(psql_ -qAt -c "select app_private.setting('wealth_params') ->> 'symbol'")
  secid=$([ "${symbol:0:2}" = sh ] && echo 1 || echo 0).${symbol:2}
  for src in tencent sina eastmoney; do
    case $src in
      tencent) url="https://web.ifzq.gtimg.cn/appstock/app/fqkline/get?param=$symbol,day,,,10,qfq" ;;
      sina) url="https://quotes.sina.cn/cn/api/json_v2.php/CN_MarketDataService.getKLineData?symbol=$symbol&scale=240&ma=no&datalen=10" ;;
      eastmoney) url="https://push2his.eastmoney.com/api/qt/stock/kline/get?secid=$secid&fields1=f1,f2,f3&fields2=f51,f53&klt=101&fqt=0&end=20500101&lmt=10" ;;
    esac
    if body=$(curl -fsS --max-time 20 "$url" 2>&1) \
       && out=$(psql_ -qAt -v src="$src" -v body="$body" 2>&1 <<'SQL'
select app_private.record_wealth_days(:'src', :'body'::jsonb);
SQL
); then
      echo "wealth: $out new day(s) of $symbol from $src"
      return 0
    fi
    errors="$errors$src: ${body:0:200} ${out:-}; "
  done
  psql_ -qAt -v symbol="$symbol" -v err="$errors" >/dev/null <<'SQL' || true
select app_private.log_system('wealth.fetch_failed', jsonb_build_object('symbol', :'symbol', 'error', :'err'));
SQL
  echo "wealth: could not fetch $symbol: $errors" >&2
  return 1
}

# One line for `dolphin status`.
jobs_status() {
  psql_ -qAt -c "select case when bool_or(last_err is not null)
      then 'jobs: FAILED ' || string_agg(job || ' ' || last_err, '; ') filter (where last_err is not null)
      else 'jobs: ok, daily done to ' || max(done_to) filter (where job = 'daily') end from public.job_runs" 2>/dev/null \
    || echo "jobs: unknown (database not ready)"
}

# The container's HEALTHCHECK: every service answers on its own port, Caddy is running and migrate has not failed.
health() {
  curl -fsS -o /dev/null http://127.0.0.1:9999/health
  curl -fsS -o /dev/null http://127.0.0.1:3000/
  curl -fsS -o /dev/null http://127.0.0.1:5000/status
  supervisorctl status caddy | grep -q RUNNING
  ! supervisorctl status migrate | grep -qE 'FATAL|BACKOFF'
}

case "${1:-}" in
  create-admin) create_admin "${2:-}" ;;
  reset-admin) reset_admin ;;
  check)   check ;;
  jobs)    case "${2:-}" in run) jobs_run ;; fetch) jobs_fetch ;; *) jobs_show ;; esac ;;
  backup)  backup ;;
  backups) ls -1t "$BACKUPS" | grep -E '^dolphin-.*\.tar\.gz(\.age)?$' || true ;;
  restore) restore "${2:-}" ;;
  status)  supervisorctl status || true; echo "version: $DOLPHIN_VERSION"; echo "latest backup: $(ls -1t "$BACKUPS" | head -1)"
           if [ -n "${BACKUP_RECIPIENT:-}" ]; then echo "backups encrypted to: $BACKUP_RECIPIENT"; else echo "backups encrypted: no (set BACKUP_RECIPIENT)"; fi
           jobs_status ;;
  health)  health ;;
  *) echo "usage: dolphin create-admin <login> | backup | backups | restore <file> | check | jobs [run|fetch] | status | health" >&2; exit 2 ;;
esac
