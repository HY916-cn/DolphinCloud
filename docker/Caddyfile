{
	email {$ACME_EMAIL}
	skip_install_trust
}

# Port 80 always sends visitors to the public address, https://$DOLPHIN_DOMAIN, whatever port Caddy listens on for HTTPS.
http://{$DOLPHIN_DOMAIN} {
	redir https://{$DOLPHIN_DOMAIN}{uri} 308
}

{$DOLPHIN_DOMAIN}:{$DOLPHIN_PORT} {
	# Written by the entrypoint: certificate files from /certs when mounted, otherwise automatic HTTPS.
	import /data/run/tls.caddy
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_path /auth/v1/* {
		reverse_proxy 127.0.0.1:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle_path /storage/v1/* {
		# Uploads are served from the app's origin: an uploaded HTML or SVG file must never run script.
		header Content-Security-Policy "default-src 'none'; sandbox"
		reverse_proxy 127.0.0.1:5000
	}
	handle /config.js {
		header Cache-Control no-store
		root * /data/run
		file_server
	}
	handle {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		# Bundles carry a content hash in their names and never change; everything else (index.html, sw.js, the
		# manifest, fonts) is checked with the server on every load so a deploy shows at once.
		@hashed path /_expo/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /_expo/static/*
		header @other Cache-Control no-cache
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
